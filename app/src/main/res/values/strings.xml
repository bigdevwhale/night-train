    <string name="rule_mirror">Answer as the person opposite would. Then they put you right.</string>
    <string name="rule_three">Three words first, exactly three. Then the whole story.</string>
    <string name="rule_child">First answer as you would have at ten, then as you would now.</string>
    <string name="rule_whisper">Answer in a whisper, leaning closer.</string>
    <string name="rule_both">Every question goes to both of you, one after the other.</string>
    <string name="rule_eyes">Hold each other\'s eyes while you answer. No looking away.</string>
    <string name="rule_hands">Hold hands for this whole stretch.</string>
    <string name="rule_silence">Ten seconds of silence before each answer. Let it surface.</string>
    <string name="rule_lie">One answer on this stretch will be untrue. Decide in secret who lies. At the end you will guess where.</string>
