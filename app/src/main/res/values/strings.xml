    <string name="st_monk">A silent monk</string>
    <string name="st_sailor_intro">“Mind if I sit? The sea taught me to ask straight.”</string>
    <string name="st_child_intro">“Mum\'s asleep. Can I ask you things? Lots of things?”</string>
    <string name="st_seer_intro">“The cards fell out on their own the moment you came in.”</string>
    <string name="st_poet_intro">“Forgive me, I collect details. Lend me a few of yours.”</string>
    <string name="st_inspector_intro">“Tickets! And answers. Five seconds each. Quickly now.”</string>
    <string name="st_granny_intro">“Take a pie, dears, and tell me about your people.”</string>
    <string name="st_traveller_intro">“I\'m from a year you\'ll both remember. I can\'t say which.”</string>
    <string name="st_monk_intro">He bows, lays a card on the table and smiles. Answer without words.</string>
